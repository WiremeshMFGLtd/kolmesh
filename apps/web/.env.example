# Server-side URL of the Fastify API (Render). No trailing slash.
API_URL=https://kolmesh-api.onrender.com
# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://kolmesh.com
# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# Must match JWT_SECRET on the API — lets the edge middleware verify admin sessions
JWT_SECRET=same-value-as-api
# Must match REVALIDATE_SECRET on the API
REVALIDATE_SECRET=same-value-as-api
