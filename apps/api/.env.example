# ── Server ─────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# Comma-separated list of allowed browser origins (your Vercel domains)
ALLOWED_ORIGINS=https://kolmesh.com,https://www.kolmesh.com,https://kolmesh.vercel.app
# Set true behind Render's proxy so rate-limits see the real client IP
TRUST_PROXY=true

# ── Database (Supabase → Project Settings → Database → Connection string, "Transaction" pooler, port 6543) ──
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Supabase Storage (Project Settings → API) ───────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server-only, never expose
SUPABASE_BUCKET=media

# ── Auth secrets (generate with: openssl rand -base64 48) ──
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# ── Anti-spam: Cloudflare Turnstile (free) ──────────────
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Email (Resend, free tier) ───────────────────────────
RESEND_API_KEY=re_...
MAIL_FROM="KOL Wire Mesh <noreply@kolmesh.com>"
MAIL_TO=servicemanager@kolmesh.com

# ── Cache revalidation (shared with the web app) ────────
WEB_URL=https://kolmesh.com
REVALIDATE_SECRET=change-me-shared-with-vercel
